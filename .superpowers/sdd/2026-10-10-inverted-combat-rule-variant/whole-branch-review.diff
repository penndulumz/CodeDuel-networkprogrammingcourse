+        db.commit()
+
+        match = Match(
+            player1_id=u1_id,
+            player2_id=u2_id,
+            bot1_id=b1_id,
+            bot2_id=b2_id,
+            p1_elo_before=1200,
+            p2_elo_before=1200,
+            is_bracket=False,
+        )
+        db.add(match)
+        db.commit()
+        match_id = match.id
+    finally:
+        db.close()
+
+    fake_result = {
+        "winner": 1,
+        "win_reason": "goal",
+        "total_turns": 12,
+        "moves": [],
+        "board_history": [],
+        "rule_variant": "standard",
+    }
+
+    with patch("server.queue.run_match", return_value=fake_result) as mock_run, \
